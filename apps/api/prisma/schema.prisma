generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MANAGER
  CONTENT_MANAGER
  ADMIN
  SYSTEM
}

enum FulfillmentMethod {
  PICKUP
}

enum PaymentMethod {
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PROOF_UPLOADED
  VERIFYING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum PaymentDocumentKind {
  PAYMENT_PROOF
  INVOICE
}

enum StorageStatus {
  PENDING_UPLOAD
  AVAILABLE
  FAILED
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  NOT_REQUIRED
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  RETRY_SCHEDULED
  FAILED
  SUPPRESSED
}

enum IdempotencyRecordStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OrderStatus {
  DRAFT
  CREATED
  AWAITING_STOCK_CONFIRMATION
  AWAITING_PAYMENT
  PAYMENT_VERIFICATION
  PAID
  ASSEMBLING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_STORE
  RESERVATION_EXPIRED
  RETURN_REQUESTED
  RETURNED
}

enum StatusSource {
  STOREFRONT
  ADMIN
  ONE_C
  SYSTEM
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

enum RelatedProductType {
  RELATED
  ALTERNATIVE
  ACCESSORY
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  RETRY_SCHEDULED
  DLQ
}

enum SyncDirection {
  INBOUND
  OUTBOUND
}

enum SyncJobStatus {
  RECEIVED
  QUEUED
  PROCESSING
  APPLIED
  RETRY_SCHEDULED
  REJECTED
  DLQ
}

enum SyncErrorSeverity {
  WARNING
  ERROR
  CRITICAL
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String    @db.VarChar(320)
  emailNormalized     String    @unique @map("email_normalized") @db.VarChar(320)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  role                Role      @default(CUSTOMER)
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(3)
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  loginLockedUntil    DateTime? @map("login_locked_until") @db.Timestamptz(3)
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  carts                   Cart[]
  orders                  Order[]
  orderStatusEvents       OrderStatusHistory[]
  verifiedPayments        Payment[]                @relation("PaymentVerifier")
  paymentDocuments        PaymentDocument[]        @relation("PaymentDocumentUploader")
  emailLogs               EmailLog[]               @relation("EmailLogRecipient")

  @@map("users")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipHash           String?   @map("ip_hash") @db.Char(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorRole     Role?    @map("actor_role")
  source        String   @db.VarChar(32)
  action        String   @db.VarChar(120)
  entityType    String   @map("entity_type") @db.VarChar(80)
  entityId      String?  @map("entity_id") @db.VarChar(128)
  reason        String?  @db.VarChar(1000)
  metadata      Json?
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  ipHash        String?  @map("ip_hash") @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope     String   @default("STORE") @db.VarChar(32)
  key       String   @db.VarChar(120)
  value     Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@map("settings")
}

model PickupLocation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(64)
  name         String   @db.VarChar(200)
  addressText  String   @map("address_text") @db.VarChar(500)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  timezone     String   @default("Asia/Yekaterinburg") @db.VarChar(64)
  phone        String?  @db.VarChar(32)
  openingHours Json?    @map("opening_hours")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouses Warehouse[]
  orders     Order[]

  @@index([active])
  @@map("pickup_locations")
}

model Category {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String   @db.VarChar(200)
  slug           String   @unique @db.VarChar(220)
  path           String   @db.VarChar(1000)
  description    String?  @db.Text
  imageUrl       String?  @map("image_url") @db.VarChar(1000)
  imageAlt       String?  @map("image_alt") @db.VarChar(300)
  seoTitle       String?  @map("seo_title") @db.VarChar(300)
  seoDescription String?  @map("seo_description") @db.VarChar(500)
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  hidden         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent                Category?                      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children              Category[]                     @relation("CategoryTree")
  normalizationMappings CategoryNormalizationMapping[]
  productCategories     ProductCategory[]
  attributeDefinitions  AttributeDefinition[]

  @@index([parentId, active, hidden, sortOrder])
  @@index([path])
  @@map("categories")
}

model CategoryNormalizationMapping {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  oneCGroupId String   @unique @map("one_c_group_id") @db.VarChar(120)
  sourceName  String   @map("source_name") @db.VarChar(300)
  sourcePath  String?  @map("source_path") @db.VarChar(1000)
  active      Boolean  @default(true)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, active])
  @@map("category_normalization_mappings")
}

model Brand {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oneCId         String   @unique @map("one_c_id") @db.VarChar(120)
  name           String   @db.VarChar(200)
  slug           String   @unique @db.VarChar(220)
  description    String?  @db.Text
  logoUrl        String?  @map("logo_url") @db.VarChar(1000)
  logoAlt        String?  @map("logo_alt") @db.VarChar(300)
  seoTitle       String?  @map("seo_title") @db.VarChar(300)
  seoDescription String?  @map("seo_description") @db.VarChar(500)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([active, sortOrder])
  @@map("brands")
}

model Product {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oneCId             String                   @unique @map("one_c_id") @db.VarChar(120)
  brandId            String?                  @map("brand_id") @db.Uuid
  baseName           String                   @map("base_name") @db.VarChar(300)
  slug               String                   @unique @db.VarChar(340)
  shortDescription   String?                  @map("short_description") @db.VarChar(1000)
  description        String?                  @db.Text
  composition        String?                  @db.Text
  application        String?                  @db.Text
  restrictions       String?                  @db.Text
  storageDescription String?                  @map("storage_description") @db.Text
  documentLinks      Json?                    @map("document_links")
  seoTitle           String?                  @map("seo_title") @db.VarChar(300)
  seoDescription     String?                  @map("seo_description") @db.VarChar(500)
  canonicalUrl       String?                  @map("canonical_url") @db.VarChar(1000)
  isHit              Boolean                  @default(false) @map("is_hit")
  isNew              Boolean                  @default(false) @map("is_new")
  popularityScore    Int                      @default(0) @map("popularity_score")
  sortOrder          Int                      @default(0) @map("sort_order")
  active             Boolean                  @default(true)
  oneCSourceVersion  String?                  @map("one_c_source_version") @db.VarChar(120)
  oneCLastSyncedAt   DateTime?                @map("one_c_last_synced_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  searchDocument     Unsupported("tsvector")? @map("search_document")

  brand             Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  images            ProductImage[]
  categories        ProductCategory[]
  attributeValues   ProductAttributeValue[]
  relatedProducts   RelatedProduct[]        @relation("RelatedProductSource")
  relatedToProducts RelatedProduct[]        @relation("RelatedProductTarget")
  orderItems        OrderItem[]

  @@index([brandId, active])
  @@index([active, isHit, isNew])
  @@index([popularityScore])
  @@map("products")
}

model ProductVariant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  oneCId            String    @unique @map("one_c_id") @db.VarChar(120)
  sku               String    @unique @db.VarChar(100)
  offerName         String    @map("offer_name") @db.VarChar(300)
  packDescription   String?   @map("pack_description") @db.VarChar(300)
  unit              String    @db.VarChar(32)
  vatRate           Decimal   @map("vat_rate") @db.Decimal(5, 2)
  minOrderQuantity  Decimal   @default(1) @map("min_order_quantity") @db.Decimal(12, 3)
  salesMultiple     Decimal   @default(1) @map("sales_multiple") @db.Decimal(12, 3)
  countryOfOrigin   String?   @map("country_of_origin") @db.VarChar(120)
  manufacturer      String?   @db.VarChar(200)
  shelfLifeDays     Int?      @map("shelf_life_days")
  storageConditions String?   @map("storage_conditions") @db.VarChar(500)
  allowBackorder    Boolean   @default(false) @map("allow_backorder")
  active            Boolean   @default(true)
  sortOrder         Int       @default(0) @map("sort_order")
  oneCSourceVersion String?   @map("one_c_source_version") @db.VarChar(120)
  oneCLastSyncedAt  DateTime? @map("one_c_last_synced_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  images            ProductImage[]
  prices            Price[]
  stockBalances     StockBalance[]
  attributeValues   ProductAttributeValue[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@index([productId, active, sortOrder])
  @@index([sku])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  objectKey String   @map("object_key") @db.VarChar(1000)
  publicUrl String   @map("public_url") @db.VarChar(1000)
  alt       String   @db.VarChar(300)
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, published, sortOrder])
  @@index([variantId])
  @@map("product_images")
}

model ProductCategory {
  productId  String  @map("product_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")
  sortOrder  Int     @default(0) @map("sort_order")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("product_categories")
}

model Price {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId     String    @map("variant_id") @db.Uuid
  priceType     String    @default("RETAIL") @map("price_type") @db.VarChar(64)
  amount        Decimal   @db.Decimal(14, 2)
  oldAmount     Decimal?  @map("old_amount") @db.Decimal(14, 2)
  currency      String    @default("RUB") @db.Char(3)
  vatIncluded   Boolean   @default(true) @map("vat_included")
  validFrom     DateTime? @map("valid_from") @db.Timestamptz(3)
  validTo       DateTime? @map("valid_to") @db.Timestamptz(3)
  sourceVersion String?   @map("source_version") @db.VarChar(120)
  lastSyncedAt  DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, priceType])
  @@index([amount])
  @@map("prices")
}

model Warehouse {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oneCId           String   @unique @map("one_c_id") @db.VarChar(120)
  code             String   @unique @db.VarChar(64)
  name             String   @db.VarChar(200)
  pickupLocationId String?  @map("pickup_location_id") @db.Uuid
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pickupLocation    PickupLocation?    @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  stockBalances     StockBalance[]
  stockReservations StockReservation[]

  @@index([pickupLocationId, active])
  @@map("warehouses")
}

model StockBalance {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  warehouseId   String   @map("warehouse_id") @db.Uuid
  onHand        Decimal  @map("on_hand") @db.Decimal(14, 3)
  reserved      Decimal  @default(0) @db.Decimal(14, 3)
  available     Decimal  @db.Decimal(14, 3)
  sourceVersion String?  @map("source_version") @db.VarChar(120)
  asOf          DateTime @default(now()) @map("as_of") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([variantId, warehouseId])
  @@index([warehouseId, available])
  @@index([variantId, available])
  @@map("stock_balances")
}

model AttributeDefinition {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String            @unique @db.VarChar(100)
  name       String            @db.VarChar(200)
  dataType   AttributeDataType @map("data_type")
  unit       String?           @db.VarChar(32)
  filterable Boolean           @default(true)
  sortOrder  Int               @default(0) @map("sort_order")
  categoryId String?           @map("category_id") @db.Uuid
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  category           Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  values             AttributeValue[]
  productAssignments ProductAttributeValue[]

  @@index([categoryId, filterable, sortOrder])
  @@map("attribute_definitions")
}

model AttributeValue {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  definitionId    String   @map("definition_id") @db.Uuid
  normalizedValue String   @map("normalized_value") @db.VarChar(300)
  displayValue    String   @map("display_value") @db.VarChar(300)
  numericValue    Decimal? @map("numeric_value") @db.Decimal(16, 4)
  booleanValue    Boolean? @map("boolean_value")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  definition  AttributeDefinition     @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  assignments ProductAttributeValue[]

  @@unique([definitionId, normalizedValue])
  @@unique([id, definitionId])
  @@index([definitionId, sortOrder])
  @@map("attribute_values")
}

model ProductAttributeValue {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  definitionId      String   @map("definition_id") @db.Uuid
  valueId           String?  @map("value_id") @db.Uuid
  textValue         String?  @map("text_value") @db.VarChar(1000)
  numericValue      Decimal? @map("numeric_value") @db.Decimal(16, 4)
  booleanValue      Boolean? @map("boolean_value")
  oneCSourceVersion String?  @map("one_c_source_version") @db.VarChar(120)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product    Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value      AttributeValue?     @relation(fields: [valueId, definitionId], references: [id, definitionId], onDelete: Restrict)

  @@index([productId, definitionId])
  @@index([variantId, definitionId])
  @@index([definitionId, valueId])
  @@map("product_attribute_values")
}

model SearchSynonym {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  normalizedTerm String   @map("normalized_term") @db.VarChar(200)
  canonicalTerm  String   @map("canonical_term") @db.VarChar(200)
  locale         String   @default("ru") @db.VarChar(10)
  weight         Decimal  @default(1) @db.Decimal(4, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([normalizedTerm, canonicalTerm, locale])
  @@index([canonicalTerm, active])
  @@map("search_synonyms")
}

model RelatedProduct {
  sourceProductId String             @map("source_product_id") @db.Uuid
  targetProductId String             @map("target_product_id") @db.Uuid
  relationType    RelatedProductType @default(RELATED) @map("relation_type")
  sortOrder       Int                @default(0) @map("sort_order")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  sourceProduct Product @relation("RelatedProductSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct Product @relation("RelatedProductTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@id([sourceProductId, targetProductId, relationType])
  @@index([targetProductId])
  @@map("related_products")
}

model Cart {
