{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Pro Dessert NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": true,
    "declaration": true,
    "removeComments": true
  }
}
