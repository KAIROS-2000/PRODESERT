# Runtime
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
STOREFRONT_PORT=3000
ADMIN_PORT=3001
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false

# PostgreSQL / Redis
POSTGRES_DB=pro_dessert
POSTGRES_USER=pro_dessert
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55432
DATABASE_URL=postgresql://pro_dessert:local-development-only@localhost:55432/pro_dessert?schema=public
REDIS_URL=redis://localhost:56379
REDIS_PORT=56379

# Sessions and integration secrets — replace outside local development
COOKIE_NAME=pro_dessert_session
COOKIE_SECURE=false
CSRF_COOKIE_NAME=pro_dessert_csrf
CSRF_TTL_SECONDS=7200
SESSION_TTL_SECONDS=1800
CART_COOKIE_NAME=pro_dessert_cart
CART_TTL_SECONDS=2592000
ORDER_PUBLIC_TOKEN_TTL_DAYS=365
ORDER_ACCESS_TOKEN_SECRET=replace-with-an-independent-32-character-secret
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
PII_HASH_SECRET=replace-with-at-least-32-random-characters
ONE_C_ADAPTER=mock
ONE_C_BASE_URL=
ONE_C_KEY_ID=local-v1
ONE_C_INBOUND_HMAC_SECRET=replace-with-an-independent-32-character-secret
ONE_C_OUTBOUND_HMAC_SECRET=replace-with-another-independent-32-character-secret
ONE_C_SIGNATURE_TOLERANCE_SECONDS=300
ONE_C_REQUEST_TIMEOUT_MS=10000
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_PROCESSING_TIMEOUT_SECONDS=300
OUTBOX_MAX_ATTEMPTS=6
WORKER_CONCURRENCY=4
RESERVATION_SWEEP_INTERVAL_MS=60000

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central-1
S3_BUCKET=pro-dessert
S3_ACCESS_KEY=pro-dessert-local
S3_SECRET_KEY=local-development-only
S3_FORCE_PATH_STYLE=true

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pro Dessert <noreply@pro-dessert.example>

# Store settings — unknown business facts remain intentionally empty
STORE_NAME=Pro Dessert
STORE_ADDRESS=Оренбург, Липовая улица, 20
STORE_PHONE=
STORE_HOURS=
PICKUP_LOCATION_CODE=orenburg-lipovaya-20
DEFAULT_RESERVATION_HOURS=24
B2B_RESERVATION_HOURS=72

# Demonstration bank details. Never use for a real transfer.
DEMO_BANK_DETAILS_ENABLED=true
BANK_RECIPIENT=ДЕМОНСТРАЦИОННЫЕ ДАННЫЕ — НЕ ДЛЯ ОПЛАТЫ
BANK_INN=0000000000
BANK_KPP=000000000
BANK_ACCOUNT=00000000000000000000
BANK_CORRESPONDENT_ACCOUNT=00000000000000000000
BANK_BIC=000000000
BANK_NAME=Демонстрационный банк

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
ANALYTICS_ENABLED=false
